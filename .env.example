# Copy to .env (gitignored) and adjust. These feed scripts/new-service.sh and
# scripts/seal-secret.sh. All non-secret — this is config, not credentials.

# GitHub Container Registry owner for service images (ghcr.io/<owner>/<svc>).
# Must be lowercase.
GHCR_OWNER="duke40199"

# Namespace every app deploys into (the ApplicationSet's destination — see
# applicationsets/apps.yaml). Changing it means also templating the namespace in
# that ApplicationSet, and it must match what seal-secret.sh seals for (both read
# this same value), or the SealedSecret won't decrypt.
NS="idac-amane"

# Optional: default image tag new-service.sh pins for a freshly scaffolded service.
# IMAGE_TAG="0.1.0"
