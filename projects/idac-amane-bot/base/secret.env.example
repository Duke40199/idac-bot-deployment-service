# Template for the out-of-band Secret. Copy to secret.env (gitignored), fill in
# real values, then:
#   kubectl -n idac-amane create secret generic idac-amane-bot-secret \
#     --from-env-file=projects/idac-amane-bot/base/secret.env
# secret.env is matched by .gitignore so it can never be committed.

# --- Credentials ---
DISCORD_BOT_TOKEN=
DB_PASSWORD=

# --- Database target ---
DB_HOST=host.minikube.internal
DB_NAME=
DB_USER=

# --- Discord identifiers ---
DISCORD_BOT_OWNER_ID=
DISCORD_OB_ACTIVE_PLAYERS_CHANNEL_ID=
DISCORD_OB_META_CARS_CHANNEL_ID=

# --- SEGA Initial D The Arcade endpoints ---
SEGA_IDAC_HOST=
SEGA_IDAC_GET_CURRENT_ROUND_URL_PATH=
SEGA_IDAC_GET_LIST_CONST_CFG_URL_PATH=
SEGA_IDAC_GET_LIST_OB_RANKING_URL_PATH=
SEGA_IDAC_GET_LIST_PLAYER_GRADE_URL_PATH=
SEGA_IDAC_GET_TEAM_RANKING_URL_PATH=
SEGA_IDAC_GET_TIME_TRAIL_URL_PATH=

# --- All.Net endpoints ---
ALLNET_HOST=
ALLNET_GET_LIST_STORE_LOCATION_URL_PATH=
ALLNET_IDAC_GAME_CODE=
ALLNET_EN_LANGUAGE_CODE=
