# Template for the sealed Secret. Copy to secret.env (gitignored), fill in real
# values, then seal it (secret.env never leaves your machine; only the encrypted
# sealed-secret.yaml is committed):
#   ./scripts/seal-secret.sh
# secret.env is matched by .gitignore so it can never be committed.
#
# IMPORTANT: use bare KEY=value — NO surrounding quotes, no trailing spaces.
# kubectl --from-env-file stores values literally, so DB_HOST="host" would be read
# WITH the quote characters (-> "no such host") and DB_PORT="5432" would fail to
# parse. Put ONLY sensitive/identifying keys here; non-secret knobs (DB_PORT,
# DB_SSLMODE, APP_ENV, PORT) live in configmap.yaml and must not be duplicated here
# (envFrom lets a duplicate key in the Secret override the ConfigMap).

# --- Credentials ---
DISCORD_BOT_TOKEN=
DB_PASSWORD=

# --- Database target (external Postgres) ---
# Use a host the pods can actually reach. For Supabase use the Session Pooler (IPv4)
# host + user, NOT the IPv6-only direct db.<ref>.supabase.co:
#   DB_HOST=aws-1-<region>.pooler.supabase.com
#   DB_USER=postgres.<project-ref>
#   DB_NAME=postgres
DB_HOST=
DB_NAME=
DB_USER=

# --- Discord identifiers ---
DISCORD_BOT_OWNER_ID=
DISCORD_OB_ACTIVE_PLAYERS_CHANNEL_ID=
DISCORD_OB_META_CARS_CHANNEL_ID=

# --- SEGA Initial D The Arcade endpoints ---
SEGA_IDAC_HOST=
SEGA_IDAC_GET_CURRENT_ROUND_URL_PATH=
SEGA_IDAC_GET_LIST_CONST_CFG_URL_PATH=
SEGA_IDAC_GET_LIST_OB_RANKING_URL_PATH=
SEGA_IDAC_GET_LIST_PLAYER_GRADE_URL_PATH=
SEGA_IDAC_GET_TEAM_RANKING_URL_PATH=
SEGA_IDAC_GET_TIME_TRAIL_URL_PATH=

# --- All.Net endpoints ---
ALLNET_HOST=
ALLNET_GET_LIST_STORE_LOCATION_URL_PATH=
ALLNET_IDAC_GAME_CODE=
ALLNET_EN_LANGUAGE_CODE=
